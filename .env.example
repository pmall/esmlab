# Biohub Platform (https://biohub.ai) API token.
BIOHUB_API_KEY=

# Modal (https://modal.com) credentials; create with `modal token new`.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Modal GPU type for the `modal` backend (Ampere or newer: A10G, L4, A100,
# A100-80GB, H100). Optional; defaults to H100. `--modal-gpu` overrides.
MODAL_GPU=

# PostgreSQL storage (`--storage postgres`). Host, port and database are
# optional (localhost:5432/esmlab); user and password are required.
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
